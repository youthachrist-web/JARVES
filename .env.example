# ==============================================================================
# THYMOS E-COMMERCE — VARIÁVEIS DE AMBIENTE (EXEMPLO)
# ==============================================================================
# Copie este arquivo para `.env` (raiz) e/ou `.env` dentro de cada app
# (apps/api, apps/admin) e preencha com valores reais.
#
# NUNCA:
#   - faça commit do arquivo `.env` real;
#   - cole segredos em código, logs, mensagens de commit ou PRs;
#   - exponha `NUVEMSHOP_APP_SECRET` ou chaves do Supabase no frontend.
#
# O app valida na inicialização (ver packages/nuvemshop-sdk/src/env.ts) que as
# variáveis obrigatórias estão presentes e falha de forma explícita se faltar
# alguma — nunca falha silenciosamente com valores mockados em produção.
# ==============================================================================

# ------------------------------------------------------------------------------
# Nuvemshop / Tiendanube — App parceiro
# ------------------------------------------------------------------------------
# ID do aplicativo cadastrado no painel de parceiros Nuvemshop (não é segredo,
# aparece publicamente na URL de autorização OAuth).
NUVEMSHOP_APP_ID=00000

# Client secret do aplicativo — SEGREDO. Nunca expor no frontend nem versionar.
NUVEMSHOP_APP_SECRET=

# URL pública de callback OAuth do seu deploy da apps/api, cadastrada no painel
# de parceiros Nuvemshop (ex.: https://api.seudominio.com/nuvemshop/callback)
NUVEMSHOP_REDIRECT_URI=https://localhost:3000/nuvemshop/callback

# User-Agent obrigatório em toda chamada à API da Nuvemshop
# (formato recomendado: "NomeDoApp (email-de-contato@dominio.com)")
NUVEMSHOP_USER_AGENT="Thymos Admin (contatothymosfits@gmail.com)"

# Escopos solicitados na autorização (separados por vírgula), conforme
# necessidade real de leitura/escrita de produtos, pedidos e clientes.
NUVEMSHOP_SCOPES=read_products,write_products,read_orders,write_orders,read_customers,write_customers

# ------------------------------------------------------------------------------
# Persistência (Supabase) — usado para guardar tokens de acesso, logs e cache
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Chave de serviço — SOMENTE no backend (apps/api). Nunca no frontend/admin.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# E-mail (SMTP) — notificações de pedido pago / app desinstalado (apps/api)
# ------------------------------------------------------------------------------
# Opcional: se SMTP_USER/SMTP_PASS não forem definidos, o envio de e-mail fica
# desativado (log de aviso, sem quebrar a aplicação).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
# Para Gmail, use uma "senha de app" (App Password), nunca a senha da conta.
SMTP_PASS=
# Destinatário das notificações. Se vazio, usa o próprio SMTP_USER.
SMTP_NOTIFY_TO=

# ------------------------------------------------------------------------------
# AbacatePay — gera o link de pagamento real do checkout (apps/api)
# ------------------------------------------------------------------------------
# Chave secreta da conta AbacatePay (abc_prod_... em produção, abc_dev_... em
# modo de testes) — SEGREDO. Nunca no frontend, sempre só no backend
# (apps/api). Sem ela, o checkout continua capturando o pedido normalmente,
# só sem gerar link de pagamento automático (ver apps/api/src/lib/abacatepay.ts).
ABACATEPAY_API_KEY=

# Segredo escolhido por você ao cadastrar o webhook de pagamento confirmado no
# painel da AbacatePay (endpoint: <sua-api>/webhooks/abacatepay?webhookSecret=SEU_SEGREDO).
# Gere algo aleatório e longo (ex.: `openssl rand -hex 32`) — SEGREDO.
ABACATEPAY_WEBHOOK_SECRET=

# URL pública do storefront publicado — para onde a AbacatePay redireciona o
# cliente ao voltar ou concluir o pagamento (ex.: https://youthachrist-web.github.io/JARVES/).
STOREFRONT_URL=

# ------------------------------------------------------------------------------
# Segurança do servidor (apps/api)
# ------------------------------------------------------------------------------
# Segredo usado para assinar sessões/cookies do painel administrativo.
SESSION_SECRET=

# Lista de origens (separadas por vírgula) autorizadas a chamar a API via CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Porta do servidor da API
PORT=3000

# ------------------------------------------------------------------------------
# Painel administrativo (apps/admin) — variáveis expostas ao build do Vite
# devem começar com VITE_ e NUNCA conter segredos.
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:3000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# Storefront (apps/storefront)
# ------------------------------------------------------------------------------
VITE_STOREFRONT_API_BASE_URL=http://localhost:3000
VITE_NUVEMSHOP_STORE_DOMAIN=

# ------------------------------------------------------------------------------
# Observabilidade / ambiente
# ------------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
