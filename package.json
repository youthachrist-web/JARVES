{
  "name": "thymos-ecommerce",
  "private": true,
  "version": "0.1.0",
  "description": "Thymos — plataforma de e-commerce integrada à Nuvemshop (storefront, painel administrativo e API)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:admin": "npm run dev --workspace apps/admin",
    "dev:storefront": "npm run dev --workspace apps/storefront"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.12.0",
    "playwright-core": "^1.63.0",
    "typescript-eslint": "^8.69.0"
  }
}
