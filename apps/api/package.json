{
  "name": "@thymos/api",
  "version": "0.1.0",
  "private": true,
  "description": "API do e-commerce Thymos — integração Nuvemshop (OAuth, sincronização, webhooks) e backend do painel administrativo",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@thymos/nuvemshop-sdk": "*",
    "express": "^4.21.1",
    "nodemailer": "^6.10.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.24",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
